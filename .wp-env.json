{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/wp-graphql.2.23.1.zip",
		"https://downloads.wordpress.org/plugin/wpgraphql-acf.3.0.0.zip",
		"https://downloads.wordpress.org/plugin/secure-custom-fields.6.9.5.zip",
		"https://downloads.wordpress.org/plugin/seo-by-rank-math.1.0.280.zip",
		"https://downloads.wordpress.org/plugin/two-factor.0.17.0.zip",
		"./wp-content/plugins/ghoroa-core"
	],
	"mappings": {
		"docs": "./docs"
	},
	"config": {
		"GN_PUBLIC_URL": "http://localhost:4321",
		"DISALLOW_FILE_EDIT": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false
	},
	"lifecycleScripts": {
		"afterStart": "node tools/wp-env.cjs run cli wp gn setup"
	}
}
